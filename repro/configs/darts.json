{
  "model": {
    "channels": 16,
    "dilations": [1, 1, 2, 2, 4, 1],
    "shift": 1,
    "context": 8,
    "width": 32,
    "depth": 2,
    "expand": 4,
    "embed_dim": 16,
    "fourier_scale": 0.25,
